<Page
    x:Class="AreaAssistant.Revit2026.AreaAssistantPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#F3F4F6">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="AI Area Assistant" />

            <Border Margin="0,12,0,0" Padding="10" Background="White" CornerRadius="4">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Agent" />
                    <TextBlock x:Name="AgentStatusText" Margin="0,4,0,0" Text="尚未连接" />
                </StackPanel>
            </Border>

            <Border Margin="0,8,0,0" Padding="10" Background="White" CornerRadius="4">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="当前文档" />
                    <TextBlock x:Name="DocumentStatusText" Margin="0,4,0,0" Text="尚未读取" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Margin="0,8,0,0" Padding="10" Background="White" CornerRadius="4">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="边界来源" />
                    <TextBlock x:Name="SelectionText" Margin="0,4,0,8" Text="未选择" TextWrapping="Wrap" />
                    <Button x:Name="ReadSelectionButton" Height="30" Content="读取当前选择" IsEnabled="False" Click="ReadSelectionButton_Click" />
                </StackPanel>
            </Border>

            <Button
                x:Name="ScanButton"
                Height="34"
                Margin="0,12,0,0"
                Content="扫描与方案"
                IsEnabled="False"
                Click="ScanButton_Click" />

            <Border Margin="0,12,0,0" Padding="10" Background="White" CornerRadius="4">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="方案" />
                    <TextBlock x:Name="ResultText" Margin="0,4,0,0" Text="尚无方案" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock
                x:Name="ErrorText"
                Margin="0,10,0,0"
                Foreground="#B91C1C"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
