{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://revit-ai-area-assistant.local/contracts/v1/chat-request.schema.json",
  "title": "Streaming chat request",
  "allOf": [
    {"$ref": "request.schema.json"},
    {
      "properties": {
        "action": {"const": "chat.stream"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["message"],
          "properties": {"message": {"type": "string", "minLength": 1}}
        }
      }
    }
  ]
}
