{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://revit-ai-area-assistant.local/contracts/v1/actions/planning-job-submit.schema.json",
  "title": "Recoverable planning job submission",
  "oneOf": [
    {
      "allOf": [
        {"$ref": "../request.schema.json"},
        {
          "properties": {
            "action": {"const": "analysis.plan.submit"},
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["context_id", "document_fingerprint", "generation", "message", "panel_instance_id", "project_directory", "retry_terminal", "session_id"],
              "properties": {
                "context_id": {"type": "string", "minLength": 1},
                "document_fingerprint": {"type": "string", "minLength": 1},
                "generation": {"type": "integer", "minimum": 0},
                "message": {"type": "string", "minLength": 1, "pattern": "\\S"},
                "panel_instance_id": {"type": "string", "minLength": 1},
                "project_directory": {"type": "string", "minLength": 1},
                "retry_terminal": {"type": "boolean"},
                "session_id": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      ]
    },
    {
      "allOf": [
        {"$ref": "../response.schema.json"},
        {
          "properties": {
            "status": {"const": "accepted"},
            "payload": {
              "$ref": "planning-job-status.schema.json#/$defs/snapshot"
            }
          }
        }
      ]
    }
  ]
}
