{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://revit-ai-area-assistant.local/contracts/v1/actions/planning-job-cancel.schema.json",
  "title": "Recoverable planning job cancellation",
  "oneOf": [
    {
      "allOf": [
        {"$ref": "../request.schema.json"},
        {
          "properties": {
            "action": {"const": "analysis.plan.cancel"},
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["context_id", "document_fingerprint", "generation", "panel_instance_id", "project_directory", "session_id"],
              "properties": {
                "context_id": {"type": "string", "minLength": 1},
                "document_fingerprint": {"type": "string", "minLength": 1},
                "generation": {"type": "integer", "minimum": 0},
                "panel_instance_id": {"type": "string", "minLength": 1},
                "project_directory": {"type": "string", "minLength": 1},
                "session_id": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      ]
    },
    {
      "allOf": [
        {"$ref": "planning-job-status.schema.json#/$defs/response"},
        {
          "properties": {
            "payload": {
              "properties": {
                "state": {
                  "enum": ["completed", "failed", "cancelled", "interrupted"]
                }
              }
            }
          }
        }
      ]
    }
  ]
}
