{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://revit-ai-area-assistant.local/contracts/v1/actions/planning-job-status.schema.json",
  "title": "Recoverable planning job status response",
  "$ref": "#/$defs/response",
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_id", "document_fingerprint", "generation", "panel_instance_id", "project_directory", "session_id"],
      "properties": {
        "context_id": {"type": "string", "minLength": 1},
        "document_fingerprint": {"type": "string", "minLength": 1},
        "generation": {"type": "integer", "minimum": 0},
        "panel_instance_id": {"type": "string", "minLength": 1},
        "project_directory": {"type": "string", "minLength": 1},
        "session_id": {"type": "string", "minLength": 1}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "question", "options"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "question": {"type": "string", "minLength": 1},
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "contains": {
            "type": "object",
            "required": ["recommended"],
            "properties": {"recommended": {"const": true}}
          },
          "minContains": 1,
          "maxContains": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "recommended", "rationale", "impact"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "label": {"type": "string", "minLength": 1},
              "recommended": {"type": "boolean"},
              "rationale": {"type": "string", "minLength": 1},
              "impact": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "message": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "retryable": {"type": "boolean"}
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "state", "stage", "created_at", "updated_at", "result", "error"],
      "properties": {
        "job_id": {"type": "string", "minLength": 1},
        "state": {"enum": ["queued", "running", "completed", "failed", "cancelled", "interrupted"]},
        "stage": {"enum": ["accepted", "validating_context", "reading_model", "capturing_evidence", "requesting_model", "validating_result", "persisting_result", "finished"]},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"},
        "result": {"type": ["object", "null"]},
        "error": {"type": ["object", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "completed"}}},
          "then": {"properties": {"result": {"$ref": "#/$defs/result"}, "error": {"const": null}}}
        },
        {
          "if": {"properties": {"state": {"enum": ["failed", "interrupted"]}}},
          "then": {"properties": {"result": {"const": null}, "error": {"$ref": "#/$defs/error"}}}
        },
        {
          "if": {"properties": {"state": {"enum": ["queued", "running", "cancelled"]}}},
          "then": {"properties": {"result": {"const": null}, "error": {"const": null}}}
        }
      ]
    },
    "response": {
      "allOf": [
        {"$ref": "../response.schema.json"},
        {
          "properties": {
            "payload": {"$ref": "#/$defs/snapshot"}
          },
          "allOf": [
            {
              "if": {"properties": {"payload": {"properties": {"state": {"enum": ["queued", "running"]}}}}},
              "then": {"properties": {"status": {"const": "accepted"}}}
            },
            {
              "if": {"properties": {"payload": {"properties": {"state": {"const": "cancelled"}}}}},
              "then": {"properties": {"status": {"const": "cancelled"}}}
            },
            {
              "if": {"properties": {"payload": {"properties": {"state": {"enum": ["completed", "failed", "interrupted"]}}}}},
              "then": {"properties": {"status": {"const": "completed"}}}
            }
          ]
        }
      ]
    },
    "poll_query": {"$ref": "#/$defs/identity"}
  }
}
