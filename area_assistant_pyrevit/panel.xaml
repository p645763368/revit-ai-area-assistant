<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#FFF7F7F7">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Padding="10" Margin="0,0,0,10" Background="White" CornerRadius="4">
      <StackPanel>
        <TextBlock Text="连接状态" FontWeight="SemiBold" />
        <TextBlock x:Name="ConnectionState" Text="连接中" Foreground="#FF1F6FEB" FontSize="16" />
        <TextBlock x:Name="ConnectionDetail" Text="正在连接本地 Agent…" TextWrapping="Wrap" Foreground="#FF555555" />
      </StackPanel>
    </Border>
    <Border Grid.Row="1" Padding="10" Margin="0,0,0,10" Background="White" CornerRadius="4">
      <StackPanel>
        <DockPanel>
          <TextBlock Text="文档安全状态" FontWeight="SemiBold" DockPanel.Dock="Left" />
          <Button x:Name="RefreshDocumentButton" Content="验证文档" MinWidth="76" DockPanel.Dock="Right" />
        </DockPanel>
        <TextBlock x:Name="DocumentState" Text="待验证" Foreground="#FF1F6FEB" FontSize="16" />
        <TextBlock x:Name="DocumentDetail" Text="打开文档后点击验证文档" TextWrapping="Wrap" Foreground="#FF555555" />
      </StackPanel>
    </Border>
    <Border Grid.Row="2" Padding="10" Margin="0,0,0,10" Background="White" CornerRadius="4">
      <StackPanel>
        <TextBlock Text="会话状态" FontWeight="SemiBold" />
        <TextBlock x:Name="SessionState" Text="等待文档验证" TextWrapping="Wrap" Foreground="#FF555555" Margin="0,2,0,8" />
        <StackPanel Orientation="Horizontal">
          <Button x:Name="ContinueSessionButton" Content="继续上次会话" IsEnabled="False" MinWidth="110" Margin="0,0,8,0" />
          <Button x:Name="NewSessionButton" Content="新建会话" IsEnabled="False" MinWidth="88" />
        </StackPanel>
      </StackPanel>
    </Border>
    <Border Grid.Row="3" Padding="10" Margin="0,0,0,10" Background="White" CornerRadius="4">
      <StackPanel>
        <TextBlock Text="AI结构化方案" FontWeight="SemiBold" />
        <TextBlock x:Name="StructuredSummary" Text="点击“扫描与方案”后，AI会只读检查模型并按需截图。" TextWrapping="Wrap" Foreground="#FF555555" Margin="0,2,0,4" />
        <TextBlock x:Name="StructuredQuestion" Text="尚无待确认方案" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,6" />
        <Button x:Name="Option1Button" IsEnabled="False" HorizontalContentAlignment="Left" Margin="0,0,0,4" />
        <Button x:Name="Option2Button" IsEnabled="False" HorizontalContentAlignment="Left" Margin="0,0,0,4" />
        <Button x:Name="Option3Button" IsEnabled="False" HorizontalContentAlignment="Left" Margin="0,0,0,4" />
        <Button x:Name="Option4Button" IsEnabled="False" HorizontalContentAlignment="Left" />
      </StackPanel>
    </Border>
    <TextBox
        x:Name="Transcript"
        Grid.Row="4"
        IsReadOnly="True"
        AcceptsReturn="True"
        TextWrapping="Wrap"
        VerticalScrollBarVisibility="Auto"
        Padding="10"
        Background="White" />
    <TextBox
        x:Name="MessageInput"
        Grid.Row="5"
        MinHeight="64"
        Margin="0,10,0,8"
        AcceptsReturn="True"
        TextWrapping="Wrap"
        VerticalScrollBarVisibility="Auto"
        ToolTip="输入给 AI 的消息" />
    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="AnalyzeButton" Content="扫描与方案" IsEnabled="False" MinWidth="96" Margin="0,0,8,0" />
      <Button x:Name="RetryButton" Content="重试" IsEnabled="False" MinWidth="72" Margin="0,0,8,0" />
      <Button x:Name="SendButton" Content="发送" IsDefault="True" IsEnabled="False" MinWidth="88" />
    </StackPanel>
  </Grid>
</Page>
